# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="SIMAK Management System"
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=simak_user
DB_PASSWORD=simak_password
DB_NAME=simak_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=simak-access-secret-change-in-production
JWT_REFRESH_SECRET=simak-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=simak-files
STORAGE_USE_SSL=false
